        local function selectTab()
            for _, t in pairs(Window.Tabs) do
                t.Content.Visible = false
                tween(t.Button, {BackgroundColor3 = Color3.fromRGB(20, 20, 20)})
                tween(t.Button:FindFirstChild("Frame"), {Size = UDim2.new(0, 0, 0, 24)})
                t.Button:FindFirstChildOfClass("TextLabel").TextColor3 = Color3.fromRGB(180, 180, 180)
                for _, sub in pairs(t.SubTabs) do
                    sub.Visible = false
                end
            end
            
            TC.Visible = true
            tween(TB, {BackgroundColor3 = Color3.fromRGB(255, 255, 255)})
            tween(Ind, {Size = UDim2.new(0, 3, 0, 24)})
            TI.TextColor3 = Color3.new(0, 0, 0)
            STB.Visible = true
            
            if not panelOpen then togglePanel() end
            Window.CurrentTab = Tab
        end
        
