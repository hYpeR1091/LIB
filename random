local function tween(obj, props, time, style, direction)
    if not obj or not obj.Parent then return end
    style = style or Enum.EasingStyle.Quint
    direction = direction or Enum.EasingDirection.Out
    local info = TweenInfo.new(time or 0.3, style, direction)
    local t = TweenService:Create(obj, info, props)
    t:Play()
    return t
end

local function ripple(parent, x, y, color)
    color = color or Color3.fromRGB(255, 255, 255)
    local r = Instance.new("Frame")
    r.AnchorPoint = Vector2.new(0.5, 0.5)
    r.BackgroundColor3 = color
    r.BackgroundTransparency = 0.5
    r.BorderSizePixel = 0
    r.Position = UDim2.new(0, x, 0, y)
    r.Size = UDim2.new(0, 0, 0, 0)
    r.ZIndex = 999
    r.Parent = parent
    
    local c = Instance.new("UICorner", r)
    c.CornerRadius = UDim.new(1, 0)
    
    tween(r, {Size = UDim2.new(0, 200, 0, 200), BackgroundTransparency = 1}, 0.6, Enum.EasingStyle.Exponential)
    task.delay(0.6, function() if r then r:Destroy() end end)
end

