local Notifs = {}
local NotifGui = nil

local function notify(text, dur, icon, color)
    dur = dur or 4
    icon = icon or "⭐"
    color = color or Color3.fromHSV((tick() % 8) / 8, 1, 1)
    
    if not NotifGui or not NotifGui.Parent then
        NotifGui = Instance.new("ScreenGui")
        NotifGui.Name = "ImpulseX_Notifs"
        NotifGui.ResetOnSpawn = false
        pcall(function() NotifGui.Parent = CoreGui end)
        if not NotifGui.Parent then NotifGui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui") end
    end
    
    local n = Instance.new("Frame")
    n.Size = UDim2.new(0, 400, 0, 90)
    n.Position = UDim2.new(1, 20, 0, #Notifs * 110 + 20)
    n.BackgroundColor3 = Color3.fromRGB(8, 8, 14)
    n.BorderSizePixel = 0
    n.ZIndex = 1000
    n.Parent = NotifGui
    
    local nc = Instance.new("UICorner", n)
    nc.CornerRadius = UDim.new(0, 18)
    
    local ns = Instance.new("UIStroke", n)
    ns.Thickness = 2.5
    ns.Color = color
    ns.Transparency = 0.5
    ns.Parent = n
    
    local ng = Instance.new("ImageLabel", n)
    ng.Image = "rbxassetid://4996891970"
    ng.ImageColor3 = color
    ng.Size = UDim2.new(1.3, 0, 1.6, 0)
    ng.Position = UDim2.new(0.5, 0, 0.5, 0)
    ng.AnchorPoint = Vector2.new(0.5, 0.5)
    ng.BackgroundTransparency = 1
    ng.ImageTransparency = 0.85
    ng.ZIndex = 999
    
    local ico = Instance.new("TextLabel", n)
    ico.Text = icon
    ico.Size = UDim2.new(0, 70, 1, 0)
    ico.BackgroundTransparency = 1
    ico.Font = Enum.Font.GothamBlack
    ico.TextSize = 36
    ico.TextColor3 = color
    ico.TextXAlignment = Enum.TextXAlignment.Center
    ico.ZIndex = 1001
    
    local txt = Instance.new("TextLabel", n)
    txt.Text = text
    txt.Size = UDim2.new(1, -100, 1, 0)
    txt.Position = UDim2.new(0, 80, 0, 0)
    txt.BackgroundTransparency = 1
    txt.Font = Enum.Font.GothamBold
    txt.TextSize = 16
    txt.TextColor3 = Color3.new(1, 1, 1)
    txt.TextXAlignment = Enum.TextXAlignment.Left
    txt.TextWrapped = true
    txt.ZIndex = 1001
    
    table.insert(Notifs, n)
    tween(n, {Position = UDim2.new(1, -420, n.Position.Y.Scale, n.Position.Y.Offset)}, 0.7, Enum.EasingStyle.Back)
    
    local conn = RunService.RenderStepped:Connect(function()
        if n and n.Parent then
            local h = (tick() % 8) / 8
            local rc = Color3.fromHSV(h, 1, 1)
            ns.Color = rc
            ng.ImageColor3 = rc
            ico.TextColor3 = rc
        else
            conn:Disconnect()
        end
    end)
    
    task.delay(dur, function()
        tween(n, {Position = UDim2.new(1, 20, n.Position.Y.Scale, n.Position.Y.Offset)}, 0.5)
        task.wait(0.6)
        if n then n:Destroy() end
        local idx = table.find(Notifs, n)
        if idx then table.remove(Notifs, idx) end
        for i, nt in ipairs(Notifs) do
            if nt and nt.Parent then
                tween(nt, {Position = UDim2.new(1, -420, 0, (i-1)*110 + 20)}, 0.4)
            end
        end
    end)
end

