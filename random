                local sbgc = Instance.new("UICorner", SBg)
                sbgc.CornerRadius = UDim.new(1, 0)
                
                local SFi = Instance.new("Frame", SBg)
                SFi.BackgroundColor3 = Color3.new(1, 1, 1)
                SFi.BorderSizePixel = 0
                SFi.Size = UDim2.new((def - min) / (max - min), 0, 1, 0)
                SFi.ZIndex = 10
                
                local sfic = Instance.new("UICorner", SFi)
                sfic.CornerRadius = UDim.new(1, 0)
                
                local SD = Instance.new("Frame", SFi)
                SD.BackgroundColor3 = Color3.new(1, 1, 1)
                SD.BorderSizePixel = 0
                SD.Position = UDim2.new(1, -8, 0.5, -8)
                SD.Size = UDim2.new(0, 16, 0, 16)
                SD.ZIndex = 11
                
                local sdc = Instance.new("UICorner", SD)
                sdc.CornerRadius = UDim.new(1, 0)
                
                local sds = Instance.new("UIStroke", SD)
                sds.Color = Color3.new(0, 0, 0)
                sds.Thickness = 2
                sds.Parent = SD
                
                local dragging = false
                
                local function update(input)
                    local pos = math.clamp((input.Position.X - SBg.AbsolutePosition.X) / SBg.AbsoluteSize.X, 0, 1)
                    val = math.floor(min + (max - min) * pos)
                    tween(SFi, {Size = UDim2.new(pos, 0, 1, 0)}, 0.1)
                    VL.Text = tostring(val)
                    if scfg.Callback then
                        pcall(scfg.Callback, val)
                    end
                end
                
                SBg.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 then
                        dragging = true
                        update(input)
                        tween(SD, {Size = UDim2.new(0, 20, 0, 20)}, 0.2, Enum.EasingStyle.Back)
                    end
                end)
                
                SBg.InputEnded:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 then
                        dragging = false
                        tween(SD, {Size = UDim2.new(0, 16, 0, 16)}, 0.2)
                    end
                end)
                
                UserInputService.InputChanged:Connect(function(input)
                    if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
                        update(input)
                    end
                end)
            end
            
