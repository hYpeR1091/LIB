                    if not gp and input.KeyCode == currentKey and kcfg.ToggleCallback then
                        pcall(kcfg.ToggleCallback)
                    end
                end)
            end
            
            -- COLORPICKER
            function Section:CreateColorPicker(ccfg)
                ccfg = ccfg or {}
                local defaultColor = ccfg.Default or Color3.new(1, 1, 1)
                
                local CF = Instance.new("Frame", Cont)
                CF.BackgroundColor3 = Color3.fromRGB(22, 22, 22)
                CF.BorderSizePixel = 0
                CF.Size = UDim2.new(1, 0, 0, 45)
                CF.ZIndex = 8
                
                local cfc = Instance.new("UICorner", CF)
                cfc.CornerRadius = UDim.new(0, 11)
                
                local CL = Instance.new("TextLabel", CF)
                CL.BackgroundTransparency = 1
                CL.Position = UDim2.new(0, 15, 0, 0)
                CL.Size = UDim2.new(1, -75, 1, 0)
                CL.Font = Enum.Font.GothamMedium
                CL.Text = ccfg.Name or "Color"
                CL.TextColor3 = Color3.new(1, 1, 1)
                CL.TextSize = 13
                CL.TextXAlignment = Enum.TextXAlignment.Left
                CL.ZIndex = 9
                
                local CD = Instance.new("TextButton", CF)
                CD.BackgroundColor3 = defaultColor
                CD.BorderSizePixel = 0
                CD.Position = UDim2.new(1, -55, 0.5, -13)
                CD.Size = UDim2.new(0, 45, 0, 26)
                CD.Text = ""
                CD.AutoButtonColor = false
                CD.ZIndex = 9
                
                local cdc = Instance.new("UICorner", CD)
                cdc.CornerRadius = UDim.new(0, 8)
                
                local cds = Instance.new("UIStroke", CD)
                cds.Color = Color3.new(1, 1, 1)
                cds.Thickness = 2
                cds.Transparency = 0.9
                cds.Parent = CD
                
                CD.MouseButton1Click:Connect(function()
                    notify("Color picker - Click to cycle colors!", 2)
                    -- Simple color cycler
                    local h, s, v = defaultColor:ToHSV()
                    h = (h + 0.1) % 1
                    defaultColor = Color3.fromHSV(h, s, v)
                    CD.BackgroundColor3 = defaultColor
                    if ccfg.Callback then
                        pcall(ccfg.Callback, defaultColor)
                    end
                end)
                
                CD.MouseEnter:Connect(function()
                    tween(cds, {Transparency = 0.7}, 0.2)
                end)
                
                CD.MouseLeave:Connect(function()
                    tween(cds, {Transparency = 0.9}, 0.2)
                end)
            end
            
            return Section
        end
        
        table.insert(Window.Tabs, Tab)
        table.insert(Tab.SubTabs, STB)
        
        if #Window.Tabs == 1 then
            selectTab()
        end
        
        return Tab
    end
    
    -- Welcome animations
    notify("IMPULSE X v4.0", 5, "⚡", Color3.fromRGB(255, 100, 255))
    notify("Welcome, " .. Players.LocalPlayer.Name, 6, "👑", Color3.fromRGB(100, 200, 255))
    notify("You are now unstoppable!", 7, "🔥", Color3.fromRGB(255, 150, 50))
    
    return Window
end

return ImpulseX
